---
import { Image } from 'astro:assets'

import {
  formatDate,
  getLocalImage,
  postPath,
  readingTime,
  type Post,
} from '../lib/posts'

import styles from '../styles/posts.module.css'

interface Props {
  post: Post
  featured?: boolean
}

const { post, featured = false } = Astro.props
const { title, description, category, cover, date } = post.data
---

<article
  class={styles.postCard}
  data-featured={featured || undefined}
  data-category={category}
  data-search={`${title} ${description} ${category} ${post.data.tags.join(' ')}`.toLowerCase()}
>
  <div class={styles.imageContainer}>
    <Image
      src={getLocalImage(cover)}
      width={1600}
      height={900}
      sizes={
        featured
          ? '(min-width: 860px) 600px, 95vw'
          : '(min-width: 1110px) 360px, (min-width: 600px) 50vw, 95vw'
      }
      alt=""
    />
    {featured && <span class={styles.featuredBadge}>Latest</span>}
  </div>

  <div class={styles.postBody}>
    <p class={styles.meta}>
      <span class={styles.category}>{category}</span>
      <time datetime={date.toISOString()}>{formatDate(date, 'short')}</time>
      <span>{readingTime(post)} min read</span>
    </p>

    <h3>
      <a href={postPath(post)}>{title}</a>
    </h3>

    <p class={styles.excerpt}>{description}</p>

    <span class={styles.readMore} aria-hidden="true">
      Read post →
    </span>
  </div>
</article>
