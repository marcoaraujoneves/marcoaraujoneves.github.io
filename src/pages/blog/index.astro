---
import Icon from '../../components/Icon.astro'
import PostsGrid from '../../components/PostsGrid.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPosts, unique } from '../../lib/posts'

import styles from '../../styles/posts.module.css'

const posts = await getPosts()
const categories = unique(posts.map(post => post.data.category))
---

<BaseLayout title="Blog">
  <header class={styles.pageHeader}>
    <h1 class={styles.pageTitle}>
      <span>Blog</span>
    </h1>
  </header>

  <div class={styles.toolbar}>
    <label class={styles.search}>
      <Icon name="search" size={18} />
      <input
        type="search"
        placeholder="Search posts…"
        aria-label="Search posts"
        data-posts-search
      />
    </label>

    {categories.length > 1 && (
      <div
        class={styles.chips}
        role="group"
        aria-label="Filter by category"
        data-posts-chips
      >
        <button type="button" aria-pressed="true" data-category="">
          All
        </button>
        {categories.map(category => (
          <button type="button" aria-pressed="false" data-category={category}>
            {category}
          </button>
        ))}
      </div>
    )}

    <p class={styles.count} aria-live="polite" data-posts-count>
      {`${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`}
    </p>
  </div>

  <PostsGrid posts={posts} highlightFirst />
</BaseLayout>

<script>
  // The site is static, so search and category filters run in the browser.
  const grid = document.querySelector<HTMLElement>('[data-posts-grid]')!
  const input = document.querySelector<HTMLInputElement>('[data-posts-search]')!
  const count = document.querySelector<HTMLElement>('[data-posts-count]')!
  const noMatches = grid.querySelector<HTMLElement>('[data-no-matches]')!
  const cards = grid.querySelectorAll<HTMLElement>('[data-search]')
  const chips = document.querySelectorAll<HTMLButtonElement>(
    '[data-posts-chips] button'
  )

  let category = ''

  function apply() {
    const query = input.value.trim().toLowerCase()
    let matches = 0

    for (const card of cards) {
      const isMatch =
        card.dataset.search!.includes(query) &&
        (!category || card.dataset.category === category)

      card.hidden = !isMatch
      if (isMatch) matches++
    }

    grid.toggleAttribute('data-filtering', Boolean(query || category))
    noMatches.hidden = matches > 0
    count.textContent = `${matches} ${matches === 1 ? 'post' : 'posts'}`

    const url = query
      ? `?search=${encodeURIComponent(query)}`
      : location.pathname
    history.replaceState(null, '', url)
  }

  input.value = new URLSearchParams(location.search).get('search') ?? ''
  input.addEventListener('input', apply)

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      category = chip.dataset.category!

      for (const other of chips) {
        other.setAttribute('aria-pressed', String(other === chip))
      }

      apply()
    })
  }

  if (input.value) apply()
</script>
