---
import { Image } from 'astro:assets'

import Icon from '../components/Icon.astro'
import PostsGrid from '../components/PostsGrid.astro'
import TechStack from '../components/TechStack.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPosts } from '../lib/posts'

import coverLetterUrl from '../assets/documents/Marco_Araujo_-_Fullstack_Software_Engineer-Cover-Letter.pdf?url'
import cvUrl from '../assets/documents/Marco_Araujo_-_Fullstack_Software_Engineer-CV.pdf?url'
import heroImage from '../assets/images/tech-cloud.png'
import styles from '../styles/home.module.css'

const latestPosts = (await getPosts()).slice(0, 4)
---

<BaseLayout>
  <div class={styles.heroWrapper}>
    <div class={styles.heroRow}>
      <div class={styles.heroContentWrapper}>
        <ul class={styles.badges}>
          <li class:list={[styles.badge, styles.badgeAvailable]}>
            <span class={styles.badgeDot} aria-hidden="true"></span>
            Open to new opportunities
          </li>
          <li class={styles.badge}>
            <Icon name="pin" size={14} />
            Rio de Janeiro, Brazil · Remote
          </li>
        </ul>

        <h1>
          <span class={styles.firstName}>Marco</span>
          <span class={styles.lastName}>Araujo</span>
        </h1>

        <p class={styles.tagline}>
          Full Stack Engineer · TypeScript · React · Vue · Node.js
        </p>

        <p>
          Full Stack Engineer with 6+ years of experience building scalable,
          high-performance web applications with TypeScript, React and Node.js,
          across SaaS, enterprise, and high-traffic e-commerce.
        </p>

        <div class={styles.actions}>
          <a href="/blog/" class={styles.primaryButton}>
            Read the blog
          </a>
          <a
            href={cvUrl}
            class:list={[styles.secondaryButton, styles.accentBorder]}
            download="Marco_Araujo_-_Fullstack_Software_Engineer-CV.pdf"
          >
            Download CV
          </a>
          <a
            href={coverLetterUrl}
            class={styles.secondaryButton}
            download="Marco_Araujo_-_Fullstack_Software_Engineer-Cover-Letter.pdf"
          >
            Download Cover Letter
          </a>
        </div>
      </div>

      <div class={styles.heroImageWrapper}>
        <Image
          src={heroImage}
          sizes="(min-width: 992px) 475px, 95vw"
          alt="Cloud of technology logos: React, TypeScript, Vue, Node.js, Remix, Shopify, GraphQL and more."
          priority
        />
      </div>
    </div>

    <TechStack />
  </div>

  <div class={styles.latestPosts}>
    <div class={styles.sectionHeader}>
      <h2>
        <span>From the</span>
        <span>blog</span>
      </h2>

      <a href="/blog/" class={styles.viewAll}>
        Visit the blog →
      </a>
    </div>

    <PostsGrid posts={latestPosts} highlightFirst />
  </div>
</BaseLayout>
