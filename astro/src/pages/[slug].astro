---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import { render } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import {
  formatDate,
  getLocalImage,
  getPosts,
  postPath,
  termPath,
  type Post,
} from '../lib/posts'

import footerStyles from '../styles/footer.module.css'
import postStyles from '../styles/post.module.css'
import postsStyles from '../styles/posts.module.css'

export const getStaticPaths = (async () => {
  // Oldest first, so "previous" is the older post and "next" the newer one.
  const posts = (await getPosts()).reverse()

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, previous: posts[index - 1], next: posts[index + 1] },
  }))
}) satisfies GetStaticPaths

interface Props {
  post: Post
  previous?: Post
  next?: Post
}

const { post, previous, next } = Astro.props
const { title, description, category, tags, date, cover } = post.data
const coverImage = getLocalImage(cover)
const { Content } = await render(post)
---

<BaseLayout
  title={title}
  description={description}
  image={coverImage}
  type="article"
>
  <article class={postStyles.postArticle}>
    <section>
      <Image
        src={coverImage}
        width={1600}
        height={800}
        sizes="(min-width: 1110px) 1110px, 95vw"
        alt={`${title} blog post cover.`}
        priority
      />

      <h1>{title}</h1>

      <p class:list={[postsStyles.postDate, postStyles.postDateCategory]}>
        <a href={termPath('category', category)}>
          <span>{category}</span>
        </a>
        &nbsp;&bull;&nbsp;
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
      </p>

      {tags.length > 0 && (
        <div>
          {tags.map(tag => (
            <a href={termPath('tag', tag)}>
              <span class={footerStyles.badge}>{tag}</span>
            </a>
          ))}
        </div>
      )}
    </section>

    <section class={postStyles.postContent}>
      <Content />
    </section>
  </article>

  <nav>
    <ul class={postStyles.postNav}>
      <li>
        {previous && (
          <a href={postPath(previous)} rel="prev">
            ← {previous.data.title}
          </a>
        )}
      </li>
      <li>
        {next && (
          <a href={postPath(next)} rel="next">
            {next.data.title} →
          </a>
        )}
      </li>
    </ul>
  </nav>
</BaseLayout>
