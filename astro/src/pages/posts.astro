---
import PostsGrid from '../components/PostsGrid.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPosts } from '../lib/posts'

const posts = await getPosts()
---

<BaseLayout title="Posts">
  <h1 data-posts-title>All posts</h1>

  <PostsGrid posts={posts} highlightFirst />
</BaseLayout>

<script>
  // The site is static, so `?search=` is applied in the browser.
  const search = new URLSearchParams(location.search)
    .get('search')
    ?.trim()
    .toLowerCase()

  if (search) {
    const title = document.querySelector<HTMLElement>('[data-posts-title]')!
    const grid = document.querySelector<HTMLElement>('[data-posts-grid]')!
    const cards = grid.querySelectorAll<HTMLElement>('[data-search]')
    let matches = 0

    title.textContent = `Results for "${search}"`

    for (const card of cards) {
      const isMatch = card.dataset.search!.includes(search)

      card.hidden = !isMatch
      card.removeAttribute('data-highlighted')
      if (isMatch) matches++
    }

    grid.querySelector<HTMLElement>('[data-no-matches]')!.hidden = matches > 0
  }
</script>
