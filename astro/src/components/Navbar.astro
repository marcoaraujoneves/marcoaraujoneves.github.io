---
import { Image } from 'astro:assets'

import Icon from './Icon.astro'
import logoLight from '../assets/images/logo-light.png'
import logoDark from '../assets/images/logo-dark.jpg'

import styles from '../styles/navbar.module.css'

const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
  { href: '/contact/', label: 'Contact' },
]

const currentPath = Astro.url.pathname.replace(/\/?$/, '/')
---

<header class={styles.header} data-header>
  <div class={styles.bar}>
    <a href="/" class={styles.logo} aria-label="Marco Araujo, home">
      <Image
        src={logoLight}
        alt=""
        width={36}
        height={36}
        layout="fixed"
        class:list={[styles.logoMark, 'icon-light']}
      />
      <Image
        src={logoDark}
        alt=""
        width={36}
        height={36}
        layout="fixed"
        class:list={[styles.logoMark, 'icon-dark']}
      />
      <span class={styles.logoText}>
        marco<span>araujo</span>
      </span>
    </a>

    <nav id="main-nav" class={styles.nav} aria-label="Main">
      <ul>
        {links.map(({ href, label }) => {
          // Sections stay highlighted on their child pages (e.g. a blog post).
          const isActive =
            href === '/' ? currentPath === href : currentPath.startsWith(href)

          return (
            <li>
              <a
                href={href}
                class:list={[styles.link, { [styles.active]: isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          )
        })}
        <li class={styles.mobileCta}>
          <a href="/contact/" class={styles.cta}>
            Let's talk
          </a>
        </li>
      </ul>
    </nav>

    <div class={styles.actions}>
      <button
        class={styles.themeToggle}
        type="button"
        aria-label="Toggle dark mode"
        data-theme-toggle
      >
        <Icon name="sun" size={18} class="icon-light" />
        <Icon name="moon" size={18} class="icon-dark" />
      </button>

      <a href="/contact/" class:list={[styles.cta, styles.desktopCta]}>
        Let's talk
      </a>

      <button
        class={styles.menuToggle}
        type="button"
        aria-label="Toggle menu"
        aria-controls="main-nav"
        aria-expanded="false"
        data-menu-toggle
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!
  const menuToggle =
    header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!
  const themeToggle = header.querySelector<HTMLButtonElement>(
    '[data-theme-toggle]'
  )!

  menuToggle.addEventListener('click', () => {
    const isOpen = header.toggleAttribute('data-open')
    menuToggle.setAttribute('aria-expanded', String(isOpen))
  })

  themeToggle.addEventListener('click', () => {
    const root = document.documentElement
    const colorMode = root.dataset.theme === 'dark' ? 'light' : 'dark'

    root.dataset.theme = colorMode
    localStorage.setItem('color-mode', colorMode)
  })
</script>
