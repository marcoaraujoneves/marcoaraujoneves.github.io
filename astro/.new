---
import { Image } from 'astro:assets'

import Icon from '../components/Icon.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { SOCIAL_LINKS } from '../consts'

import cvUrl from '../assets/documents/Marco_Araujo_-_Fullstack_Software_Engineer-CV.pdf?url'
import logoDark from '../assets/images/logo-dark.jpg'
import logoLight from '../assets/images/logo-light.png'
import styles from '../styles/about.module.css'

const highlights = [
  '6+ years building web apps, from startup SaaS to US e-commerce',
  'Fully remote and async, working with teams across time zones',
  'TypeScript, React and Node.js at the core, with experience in Vue React Native',
  'Serverless with Firebase, and some PostgreSQL for relational data',
  'Web performance, Core Web Vitals, SEO, and Accessibility best practices',
  'Agentic Engineering and AI Coding with Claude Code, Agent Skills, and MCPs',
]

const stats = [
  { value: '6+', label: 'Years of experience' },
  { value: '2+', label: 'Years of AI-assisted code' },
  { value: 'US + BR', label: 'Remote teams across time zones' },
]

const stack = [
  {
    title: 'Frontend',
    items: [
      'React',
      'Remix / React Router',
      'Vue',
      'Nuxt',
      'Gatsby',
      'React Native',
    ],
  },
  {
    title: 'Backend',
    items: [
      'Node.js',
      'Express',
      'Firebase',
      'GraphQL',
      'REST APIs',
      'Serverless',
    ],
  },
  {
    title: 'Languages',
    items: ['TypeScript', 'JavaScript', 'Sass', 'SQL', 'C++'],
  },
  {
    title: 'E-commerce',
    items: [
      'Shopify Hydrogen',
      'Storefront API',
      'Admin API',
      'Headless commerce',
    ],
  },
  {
    title: 'Web quality',
    items: [
      'Core Web Vitals',
      'Lighthouse',
      'Web performance',
      'SEO',
      'Accessibility',
    ],
  },
  {
    title: 'AI tools',
    items: [
      'Claude Code',
      'Claude API',
      'Model Context Protocol',
      'Agent skills',
    ],
  },
]

const experience = [
  {
    period: '2025 – now',
    role: 'Fullstack Engineer',
    place: 'Form Factory',
    context: 'Headless e-commerce · US brands',
    responsibilities: [
      'Building headless storefronts and maintaining features for leading US brands',
      'Working as a forward deployed engineer, reporting to the merchant staff',
      'Planning around seasonal demand: ship, validate, harden, discover',
    ],
    impact: [
      'Led a performance program that took Lighthouse and Core Web Vitals from poor to production standards',
      'Rebuilt the Customer Hub for a major clothing brand: loyalty provider, account, orders and support',
      'Rebuilt the Product Detail Page for that same brand: optimized markup and components, media assets, raised Add-to-Cart perceived speed, pushed Lighhouse scores by 20+ points',
    ],
    tags: [
      'TypeScript',
      'React',
      'Remix / RR7',
      'Shopify Hydrogen',
      'Performance / CWV',
      'SEO',
    ],
  },
  {
    period: '2020 – 2025',
    role: 'Fullstack Engineer',
    place: 'EasyRetro',
    context: 'SaaS · Fully remote and async',
    responsibilities: [
      'End-to-end product work across EasyRetro, Slideasy and PlanITPoker, from feature planning to release',
      'Wearing many hats: discovery, prototyping, implementation, analytics, SEO and some customer support',
    ],
    impact: [
      'Built Slideasy from scratch up to its MVP launch',
      'Led the migration of PlanITPoker to a new stack while it moved from free to paid',
    ],
    tags: [
      'JavaScript',
      'Vue',
      'Nuxt',
      'Node.js',
      'Firebase',
      'FLUX',
      'Stable Diffusion',
      'Open AI APIs',
    ],
  },
  {
    period: '2020',
    role: 'Freelance Developer',
    place: 'Satélite Norte',
    context: 'Audit platform · Freelance',
    responsibilities: [
      'Client meetings, requirements, prototypes, UI/UX, planning and implementation',
      'Built three web apps for auditing transportation agencies, with a React/React Native frontend and Node.js backend',
    ],
    impact: [
      'The software is being used to audit hundreds of agencies, providing centralized insights, planning and requests',
    ],
    tags: ['React', 'React Native', 'Node.js', 'PostgreSQL'],
  },
]

const education = [
  {
    period: 'From 2016',
    title: 'B.Sc. in Computer Engineering',
    place: 'Rio de Janeiro State University (UERJ)',
    text: 'A strong STEM foundation, from calculus and physics to algorithms, databases, networks and machine learning.',
  },
  {
    period: '2014',
    title: 'Technical course in Programming',
    place: 'ETEC, São Paulo',
    text: 'Systems analysis, SQL, web development with JavaScript and PHP, and desktop software with Java and C#.',
  },
]

const academic = [
  {
    period: '2019',
    title: 'IT Intern · UERJ',
    text: 'A climate-monitoring mobile app with Ionic and a Java REST API for disaster prevention, published on Google Play.',
  },
  {
    period: '2017',
    title: 'Junior Project Manager & Engineer · Serra Jr. Engenharia',
    text: 'Managed backlogs and delivered web apps with Angular, PHP and JavaScript, plus an Arduino temperature-control IoT solution.',
  },
]
---

<BaseLayout title="About me" image={logoLight}>
  <h1 class={styles.pageTitle}>
    <span>About</span>
    <span>me</span>
  </h1>

  <div class={styles.layout}>
    <aside class={styles.card}>
      <div class={styles.photo}>
        <Image
          src={logoLight}
          alt="Marco Araujo"
          width={168}
          height={168}
          layout="fixed"
          class:list={[styles.photoImage, 'icon-light']}
        />
        <Image
          src={logoDark}
          alt="Marco Araujo"
          width={168}
          height={168}
          layout="fixed"
          class:list={[styles.photoImage, 'icon-dark']}
        />
      </div>

      <p class={styles.name}>Marco Araujo</p>
      <p class={styles.role}>Full Stack Engineer</p>

      <p class={styles.location}>
        <Icon name="pin" size={14} />
        Rio de Janeiro, Brazil · BRT · UTC−3
      </p>
      <p class={styles.note}>Overlaps with US Eastern &amp; Central hours</p>

      <div class={styles.links}>
        <a href={SOCIAL_LINKS.github} aria-label="GitHub">
          <Icon name="github" size={20} />
        </a>
        <a href={SOCIAL_LINKS.linkedin} aria-label="LinkedIn">
          <Icon name="linkedin" size={20} />
        </a>
        <a
          href={cvUrl}
          class={styles.cv}
          download="Marco_Araujo_-_Fullstack_Software_Engineer-CV.pdf"
        >
          Download CV
        </a>
      </div>
    </aside>

    <div class={styles.content}>
      <h2 class={styles.headline}>
        Building for the web, <span>end to end.</span>
      </h2>

      <p>
        Hi, I'm Marco! I'm a Fullstack Software Engineer with 6+ years of
        experience building scalable, high-performance web applications with
        TypeScript, React and Node.js. I've worked across small SaaS startups,
        enterprise projects and high-traffic e-commerce, and I enjoy engaging in
        the whole product lifecycle, from the first prototype to launch.
      </p>

      <p>
        Lately, I'm specializing in Agentic Engineering and AI Coding thorugh
        harnesses like Claude Code, and building AI-powered applications through
        LLM APIs like Claude.
      </p>

      <p>
        Holding a Bachelor's Degree in Computer Engineering, I learned through a
        mixture of hands-on coding and a strong STEM foundation that still
        shapes how I work. I strongly believe that the strongest lever in
        software development lies in the structured application of engineering
        practices, processes and principles, and I strive to apply them in every
        project I work on.
      </p>

      <ul class={styles.highlights}>
        {highlights.map(item => (
          <li>{item}</li>
        ))}
      </ul>

      <ul class={styles.stats}>
        {stats.map(({ value, label }) => (
          <li>
            <strong>{value}</strong>
            <span>{label}</span>
          </li>
        ))}
      </ul>

      <h2 class={styles.sectionTitle}>Tech stack</h2>

      <div class={styles.stack}>
        {stack.map(({ title, items }) => (
          <section>
            <h3>{title}</h3>
            <ul>
              {items.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <h2 class={styles.sectionTitle}>Experience</h2>

      <ol class={styles.timeline}>
        {experience.map(
          ({
            period,
            role,
            place,
            context,
            responsibilities,
            impact,
            tags,
          }) => (
            <li>
              <span class={styles.period}>{period}</span>
              <h3>
                {role} <span>· {place}</span>
              </h3>
              <p class={styles.context}>{context}</p>

              <h4>What I do</h4>
              <ul class={styles.bullets}>
                {responsibilities.map(item => (
                  <li>{item}</li>
                ))}
              </ul>

              <h4>Impact</h4>
              <ul class={styles.bullets}>
                {impact.map(item => (
                  <li>{item}</li>
                ))}
              </ul>

              <ul class={styles.tags}>
                {tags.map(tag => (
                  <li>{tag}</li>
                ))}
              </ul>
            </li>
          )
        )}
      </ol>

      <h2 class={styles.sectionTitle}>Academic projects</h2>

      <ol class={styles.timeline}>
        {academic.map(({ period, title, text }) => (
          <li>
            <span class={styles.period}>{period}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>

      <h2 class={styles.sectionTitle}>Education</h2>

      <ol class={styles.timeline}>
        {education.map(({ period, title, place, text }) => (
          <li>
            <span class={styles.period}>{period}</span>
            <h3>
              {title} <span>· {place}</span>
            </h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>

      <p class={styles.closing}>
        Through this blog, I share what I learn along the way. Want to chat?
        <a href="/contact/">Get in touch</a> or read the
        <a href="/blog/hello-world/">full story</a>.
      </p>
    </div>
  </div>
</BaseLayout>
